<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Schema tooling is delivered only inside the self-contained exceldb executable. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools"
                      Version="2.81.1"
                      PrivateAssets="All"
                      GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\exceldb\options.proto"
              ProtoRoot="Protos"
              GrpcServices="None" />
    <None Update="Protos\exceldb\options.proto"
          Link="schema-system\exceldb\options.proto"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="false" />
    <None Include="$(PkgGrpc_Tools)\build\native\include\google\protobuf\**\*.proto"
          Link="schema-system\google\protobuf\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="false" />
    <None Include="$(PkgGrpc_Tools)\tools\windows_x64\protoc.exe"
          Link="schema-tools\windows-x64\protoc.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
